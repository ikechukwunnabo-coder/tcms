# ── Django core ────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, e.g. https://portal.example.com
CSRF_TRUSTED_ORIGINS=
# API schema + Swagger UI: always on with DEBUG; set true to expose in staging/prod.
EXPOSE_API_DOCS=false

# ── Production TLS (config.settings.prod) ──────────────────────
# Set false only for a staging host without TLS.
SECURE_SSL_REDIRECT=true
# Enable only behind a trusted reverse proxy that sets X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=false
# Sliding browser-session idle timeout (seconds; 28800 = 8 h).
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=true

# ── Database ───────────────────────────────────────────────────
# Leave USE_SQLITE=true for a zero-setup dev/test run (no Postgres needed).
USE_SQLITE=true
DB_ENGINE=postgresql
DB_NAME=tcms
DB_USER=tcms
DB_PASSWORD=tcms
DB_HOST=localhost
DB_PORT=5432

# ── Celery / Redis ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Shared cache for throttling (prod only; dev/tests use LocMem).
REDIS_CACHE_URL=redis://localhost:6379/2

# ── Email (dev: console; docker-compose provides Mailpit on :1025) ──
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Mailpit/dev has no TLS. Production SMTP usually needs EMAIL_USE_TLS=true.
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@tcms.local

# ── Object storage (MinIO / S3) ────────────────────────────────
USE_S3_STORAGE=false
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=tcms-documents
AWS_S3_REGION_NAME=us-east-1

# -- Outbox webhooks (Celery beat dispatches every minute) --
# Comma-separated absolute URLs; empty acknowledges events without delivering.
OUTBOX_WEBHOOK_URLS=
WEBHOOK_SIGNING_SECRET=
OUTBOX_MAX_ATTEMPTS=5

# ── Seed (SEED_ROLES admin user) ───────────────────────────────
SEED_ADMIN_USER=admin
# Leave blank to generate a strong password on first seed (printed once).
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@tcms.local
# Demo seed: leave blank to generate a one-time password.
DEMO_PASSWORD=

# ── Portal links & rate limits ─────────────────────────────────
PORTAL_WEB_BASE_URL=http://127.0.0.1:8000
PORTAL_WEB_PATH=/portal/
PORTAL_VERIFY_URL=http://127.0.0.1:8000/portal/verify-email/
PORTAL_VERIFY_TTL_HOURS=24
PORTAL_RESEND_LIMIT=5
PORTAL_RESEND_WINDOW=3600
PORTAL_LOGIN_RATE_LIMIT=10
PORTAL_LOGIN_RATE_WINDOW=300
PORTAL_REGISTER_RATE_LIMIT=20
PORTAL_REGISTER_RATE_WINDOW=3600
PORTAL_RESET_RATE_LIMIT=5
PORTAL_RESET_RATE_WINDOW=3600
API_LOGIN_RATE=10/min
API_REGISTER_RATE=20/hour
# API bearer-token lifetime; 0 disables expiry (not recommended in production).
API_TOKEN_TTL_HOURS=24
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
# Number of trusted reverse proxies for DRF throttle client identification
# (0 = use REMOTE_ADDR only; set to 1+ behind a proxy).
DRF_NUM_PROXIES=0
# Django-admin sign-in failure limit (fixed window, seconds).
ADMIN_LOGIN_RATE_LIMIT=10
ADMIN_LOGIN_RATE_WINDOW=300

# ── Billing ─────────────────────────────────────────────────────
# VAT percentage applied to invoice lines. 0 is safe until Finance confirms the
# applicable rate; set the confirmed rate (e.g. 7.5) before go-live.
BILLING_TAX_PCT=0

# ── Scheduling capacity rules ───────────────────────────────────
# Layer 1: total seats across concurrent sessions may not exceed venue capacity.
ENFORCE_FACILITY_CAPACITY=true
# Layer 2: a venue hosts at most one live session at a time.
ENFORCE_VENUE_EXCLUSIVITY=true

# ── Certificate branding (PDF rendering) ────────────────────────
CERTIFICATE_ORG_NAME=TASL Training Centre
CERTIFICATE_ORG_ADDRESS=
CERTIFICATE_TITLE=CERTIFICATE OF TRAINING
# Storage keys for logo/signature/seal artwork (local media or S3/MinIO).
CERTIFICATE_LOGO_KEY=
CERTIFICATE_SIGNATORY_NAME=Managing Director
CERTIFICATE_SIGNATORY_TITLE=Managing Director
# Optional public verification URL printed in the certificate footer.
CERTIFICATE_VERIFY_URL=

# ── Payroll reference data (confirm with Finance before go-live) ──
PAYROLL_PENSION_EMPLOYEE_PCT=7.5
PAYROLL_PENSION_EMPLOYER_PCT=7.5
PAYROLL_PAYE_ANNUAL_RELIEF=0
PAYROLL_TIMESHEET_PENSIONABLE=false
PAYROLL_GL_SALARY_EXPENSE=500000
PAYROLL_GL_EMPLOYER_PENSION=501000
PAYROLL_GL_NET_PAY=210000
PAYROLL_GL_PAYE=220000
PAYROLL_GL_PENSION=230000
PAYROLL_GL_DEDUCTIONS=240000

# NOTE: no AXIS_* variables — AXIS is a read-only reference, never a runtime
# dependency.
